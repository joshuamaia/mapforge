{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "mapforge": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "mf",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "webWorkerTsConfig": "tsconfig.worker.json",
            "inlineStyleLanguage": "scss",
            "loader": { ".txt": "text" },
            "outputMode": "static",
            "assets": [
              { "glob": "**/*", "input": "public" },
              {
                "glob": "**/*",
                "input": "node_modules/monaco-editor/min/vs",
                "output": "assets/monaco/vs",
                "ignore": ["**/*.map"]
              }
            ],
            "styles": ["node_modules/@angular/cdk/overlay-prebuilt.css", "src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "900kB", "maximumError": "1.5MB" },
                { "type": "anyComponentStyle", "maximumWarning": "8kB", "maximumError": "16kB" }
              ],
              "optimization": {
                "scripts": true,
                "fonts": false,
                "styles": { "minify": true, "inlineCritical": false }
              },
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "mapforge:build:production" },
            "development": { "buildTarget": "mapforge:build:development" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "mapforge:build:development",
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "setupFiles": ["src/test-setup.ts"],
            "include": [
              "src/app/features/**/*.spec.ts",
              "src/app/shared/**/*.spec.ts",
              "src/app/app.spec.ts"
            ]
          }
        }
      }
    }
  }
}
