{
  "name": "mapforge",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:core && npm run test:ui",
    "test:core": "vitest run",
    "test:ui": "ng test --watch=false",
    "test:e2e": "ng build && playwright test",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"tests/**/*.ts\""
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "dexie": "^4.4.7",
    "monaco-editor": "^0.57.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "1.64",
    "@types/node": "^22.12.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "description": "MapForge — Visual Data Mapping Studio"
}
